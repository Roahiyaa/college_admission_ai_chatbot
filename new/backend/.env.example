# .env.example — Copy this to .env and fill in your values
# NEVER commit the actual .env file to git

# Google Gemini API key (get one free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Admin dashboard password
ADMIN_PASSWORD=your_admin_password_here

# Flask session secret key (generate a random string, e.g.: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here
