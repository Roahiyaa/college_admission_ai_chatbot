{
  // ── CSS / Tailwind ──────────────────────────────────────────────────────────
  // Disable the built-in CSS / SCSS / Less validators entirely so that
  // @tailwind, @apply, @layer, @screen directives don't get flagged.
  "css.validate": false,
  "scss.validate": false,
  "less.validate": false,
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "css.lint.vendorPrefix": "ignore",
  "css.lint.propertyIgnoredDueToDisplay": "ignore",

  // ── Tailwind IntelliSense ────────────────────────────────────────────────────
  "tailwindCSS.experimental.configFile": "./tailwind.config.js",
  "tailwindCSS.includeLanguages": {
    "html": "html",
    "javascript": "javascript",
    "css": "css"
  },
  "editor.quickSuggestions": {
    "strings": true
  },

  // ── Python ──────────────────────────────────────────────────────────────────
  // Add backend/ to extra paths so Pylance + Pyrefly can resolve
  // `from models import ...` without the try/except trick.
  "python.analysis.extraPaths": [
    "${workspaceFolder}",
    "${workspaceFolder}/backend"
  ],
  "python.analysis.autoSearchPaths": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,

  // Suppress Pylance warnings that are too noisy for SQLAlchemy dynamic attrs.
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.reportMissingModuleSource": "none",
  "python.analysis.reportUnknownVariableType": "none",
  "python.analysis.reportUnknownMemberType": "none",

  // ── Pyrefly ─────────────────────────────────────────────────────────────────
  "pyrefly.projectRoots": [
    "${workspaceFolder}/backend"
  ],

  // ── Editor ──────────────────────────────────────────────────────────────────
  "editor.formatOnSave": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  }
}
